FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

# Собираем проект
RUN npm run build

# Устанавливаем простой http сервер для статики
RUN npm install -g serve

EXPOSE 3008

# Запускаем собранные файлы.
#
# Флага -s тут намеренно НЕТ. Он включает SPA-фолбэк на ВСЁ подряд: любой
# ненайденный путь, включая /assets/*.js, отдаётся как index.html со статусом
# 200 и Content-Type: text/html. Если index.html почему-то устарел и ссылается
# на бандл, которого после пересборки уже нет, браузер получает HTML вместо
# JS-модуля, отказывается его исполнять, и пользователь видит пустой экран без
# единого намёка на причину — вместо честного 404, который диагностируется
# мгновенно. Маршруты SPA перечислены явными rewrites в public/serve.json.
CMD ["serve", "dist", "-l", "3008"]